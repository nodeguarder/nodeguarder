FROM rust:slim-bookworm AS builder

RUN apt-get update && apt-get install -y protobuf-compiler pkg-config libssl-dev g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY proto ./proto
COPY migrations ./migrations
COPY build.rs ./
COPY src ./src
COPY atr_rules.json ./

RUN cargo build --release --no-default-features --features enterprise,semantic

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/nodeguarder-agent .
COPY migrations ./migrations
EXPOSE 3000 50051
CMD ["./nodeguarder-agent", "--portal"]
