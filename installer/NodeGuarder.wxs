<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="NodeGuarder"
             Language="1033"
             Version="$(var.Version)"
             Manufacturer="NodeGuarder"
             UpgradeCode="cd1f4bab-51e9-4885-ae5f-fb5b08ccc479">

        <Package InstallerVersion="200"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Manufacturer="NodeGuarder"
                 Description="AI Security Gateway – Local semantic firewall for LLM interactions"
                 Platform="x64" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of NodeGuarder is already installed."
                      AllowSameVersionUpgrades="yes" />

        <MediaTemplate EmbedCab="yes" />

        <WixVariable Id="WixUILicenseRtf" Value="$(var.InstallerDir)\EULA.rtf" />

        <UI>
            <UIRef Id="WixUI_Minimal" />
        </UI>

        <Icon Id="AppIcon" SourceFile="$(var.SourceDir)icon.ico" />

        <Property Id="ARPPRODUCTICON" Value="AppIcon" />
        <Property Id="ARPHELPLINK" Value="https://nodeguarder.com" />
        <Property Id="ARPNOREPAIR" Value="yes" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLDIR" Name="NodeGuarder">
                    <Component Id="MainExe" Guid="*">
                        <File Id="MainExe"
                              Name="nodeguarder-agent.exe"
                              Source="$(var.SourceDir)nodeguarder-agent.exe"
                              KeyPath="yes" />
                        <RemoveFolder Id="RemoveINSTALLDIR" On="uninstall" />
                    </Component>

                    <Component Id="InstallDirReg" Guid="*">
                        <RegistryValue Root="HKLM"
                                       Key="Software\NodeGuarder"
                                       Name="InstallDir"
                                       Type="string"
                                       Value="[INSTALLDIR]"
                                       KeyPath="yes" />
                    </Component>

                    <Component Id="OrtDll" Guid="*">
                        <File Id="OrtDll"
                              Name="onnxruntime.dll"
                              Source="$(var.SourceDir)onnxruntime.dll"
                              KeyPath="yes" />
                    </Component>

                    <Component Id="AtrRules" Guid="*">
                        <File Id="AtrRules"
                              Name="atr_rules.json"
                              Source="$(var.SourceDir)atr_rules.json"
                              KeyPath="yes" />
                    </Component>

                    <Component Id="AutoStartRun" Guid="*">
                        <RegistryValue Root="HKLM"
                                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                                       Name="NodeGuarder"
                                       Type="string"
                                       Value="[INSTALLDIR]nodeguarder-agent.exe"
                                       KeyPath="yes" />
                    </Component>
                </Directory>
            </Directory>

            <Directory Id="ProgramMenuFolder">
                <Directory Id="AppProgramMenuFolder" Name="NodeGuarder">
                    <Component Id="StartMenuShortcuts" Guid="*">
                        <Shortcut Id="StartMenuShortcut"
                                  Directory="AppProgramMenuFolder"
                                  Name="NodeGuarder"
                                  Description="AI Security Gateway"
                                  WorkingDirectory="INSTALLDIR"
                                  Icon="AppIcon"
                                  Advertise="no" />
                        <RegistryValue Root="HKCU"
                                       Key="Software\NodeGuarder"
                                       Name="ShortcutInstalled"
                                       Type="integer"
                                       Value="1"
                                       KeyPath="yes" />
                        <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <CustomAction Id="KillAgentInstall"
                       Script="vbscript"
                       Execute="immediate"
                       Impersonate="no"
                       Return="ignore">
            <![CDATA[
                On Error Resume Next
                Dim shell
                Set shell = CreateObject("WScript.Shell")
                shell.Run "taskkill /f /im nodeguarder-agent.exe", 0, True
            ]]>
        </CustomAction>

        <CustomAction Id="KillAgentDeferred"
                       Script="vbscript"
                       Execute="deferred"
                       Impersonate="no"
                       Return="ignore">
            <![CDATA[
                On Error Resume Next
                Dim shell
                Set shell = CreateObject("WScript.Shell")
                shell.Run "taskkill /f /im nodeguarder-agent.exe", 0, True
            ]]>
        </CustomAction>

        <CustomAction Id="RemoveAppData"
                       Script="vbscript"
                       Execute="immediate"
                       Impersonate="yes"
                       Return="ignore">
            <![CDATA[
                On Error Resume Next
                Dim shell, appdata
                Set shell = CreateObject("WScript.Shell")
                appdata = shell.ExpandEnvironmentStrings("%APPDATA%")
                shell.Run "cmd.exe /C rmdir /s /q """ & appdata & "\NodeGuarder""", 0, True
            ]]>
        </CustomAction>

        <CustomAction Id="LaunchAgent"
                       Directory="INSTALLDIR"
                       ExeCommand="[#MainExe]"
                       Execute="immediate"
                       Return="asyncNoWait" />

        <InstallExecuteSequence>
            <Custom Action="KillAgentInstall" Before="InstallValidate">NOT Installed OR UPGRADINGPRODUCTCODE</Custom>
            <Custom Action="KillAgentDeferred" Before="InstallFiles">REMOVE="ALL" OR UPGRADINGPRODUCTCODE</Custom>
            <Custom Action="RemoveAppData" After="InstallValidate">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
            <Custom Action="LaunchAgent" After="InstallFinalize" />
        </InstallExecuteSequence>

        <Feature Id="MainFeature"
                 Title="NodeGuarder"
                 Description="AI security gateway executable and runtime components"
                 Level="1"
                 ConfigurableDirectory="INSTALLDIR">
            <ComponentRef Id="MainExe" />
            <ComponentRef Id="InstallDirReg" />
            <ComponentRef Id="OrtDll" />
            <ComponentRef Id="AtrRules" />
            <ComponentRef Id="AutoStartRun" />
            <ComponentRef Id="StartMenuShortcuts" />
        </Feature>
    </Product>
</Wix>
